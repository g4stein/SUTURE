{
  "name": "@g4stein/suture-mcp",
  "version": "0.1.0",
  "description": "Local Model Context Protocol server for Suture: audit cross-engine spreadsheet models (formulas, DuckDB SQL, Python/NumPy) with property-based testing, and verify formula patches in memory.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "suture-mcp": "./dist/suture-mcp.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g4stein/SUTURE.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/g4stein/SUTURE/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/g4stein/SUTURE/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kiro",
    "spreadsheet",
    "duckdb",
    "pyodide",
    "property-based-testing",
    "fast-check"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vite build && vitest --run",
    "test:pack": "vite build && vitest --run --config vitest.pack.config.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@modelcontextprotocol/server": "2.4.0",
    "pyodide": "314.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@suture/core": "workspace:*",
    "@suture/runtime": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
